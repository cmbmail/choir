# 复制为服务器 /opt/choir/.env — 仅 IP 访问（无 HTTPS）
# cp .env.production-ip.example .env

FLASK_ENV=production
AUTH_MODE=development
SECRET_KEY=请运行 openssl rand -hex 32 替换
JWT_SECRET=请运行 openssl rand -hex 32 替换
INVITE_CODE_PEPPER=请运行 openssl rand -hex 32 替换

DATABASE_URL=mysql+pymysql://choir:你的MySQL密码@127.0.0.1:3306/choir_db?charset=utf8mb4

SYSTEM_SUPER_ADMIN_USERNAME=13800000000
SYSTEM_SUPER_ADMIN_PASSWORD=请设置强密码

LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_CAPTCHA_AFTER_FAILURES=3
JWT_EXPIRE_HOURS=24
INVITE_CODE_LENGTH=8
INVITE_CODE_DEFAULT_EXPIRE_DAYS=7
MAX_MEMBERS_PER_CHOIR=100
