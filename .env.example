# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# Auth mode: development | production
# development: Bearer token in JSON + localStorage
# production: httpOnly Cookie + CSRF
AUTH_MODE=development

# Login security (phase 1)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_CAPTCHA_AFTER_FAILURES=3
JWT_EXPIRE_HOURS=24
PASSWORD_MIN_LENGTH=8

# Database
# 开发：本机或 Docker MySQL 8.0
DATABASE_URL=mysql+pymysql://choir:password@127.0.0.1:3306/choir_db?charset=utf8mb4

# 生产：阿里云 RDS MySQL 8.0（VPC 内网地址，勿用公网端点）
# DATABASE_URL=mysql+pymysql://choir:password@rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/choir_db?charset=utf8mb4

# 阿里云 RAM（API 调用用 AccessKey；勿写入 Git、勿提交仓库）
# 控制台：https://ram.console.aliyun.com/manage/ak
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# RAM 登录名（控制台登录用，SDK 通常不需要）
ALIYUN_RAM_ACCOUNT=

# 阿里云盘企业版 CDE（阶段二在控制台获取后填写）
CDE_REGION=cn-hangzhou
CDE_ENDPOINT=
CDE_DRIVE_ID=
CDE_ENTERPRISE_ID=
CDE_ROOT_FOLDER_ID=

# App
# 每团成员上限（新建 choir 时默认写入 choirs.max_members）
MAX_MEMBERS_PER_CHOIR=100
# 系统超管（choir_id 为空；用于 POST /api/choirs 创建合唱团）
SYSTEM_SUPER_ADMIN_USERNAME=admin
SYSTEM_SUPER_ADMIN_PASSWORD=change-me
REGISTRATION_MODE=invite_only
INVITE_CODE_DEFAULT_EXPIRE_DAYS=7
INVITE_CODE_LENGTH=8
