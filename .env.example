# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# Auth mode: development | production
# development: Bearer token in JSON + localStorage
# production: httpOnly Cookie + CSRF
AUTH_MODE=development

# Login security (phase 1)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_CAPTCHA_AFTER_FAILURES=3
JWT_EXPIRE_HOURS=24
PASSWORD_MIN_LENGTH=8

# Database（生产：ECS 同机 MySQL 127.0.0.1；开发：本机 Docker）
DATABASE_URL=mysql+pymysql://choir:password@127.0.0.1:3306/choir_db?charset=utf8mb4

# 上传存储：mock=ECS本地盘 | pds=网盘与相册服务企业版
CDE_MODE=mock
CDE_STORAGE_ROOT=/opt/choir/storage
MAX_UPLOAD_BYTES=4294967296
UPLOAD_BLOCKLIST_EXT=exe,bat,cmd,sh,msi,dmg
CDE_STORAGE_QUOTA_BYTES=53687091200

# 阿里云 RAM（PDS OpenAPI 签名；勿提交仓库）
# https://ram.console.aliyun.com/manage/ak
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# PDS 企业版（见 deploy/PDS-ENTERPRISE.md）
# 企业代码 Domain ID：控制台 → 企业设置
CDE_DOMAIN_ID=
CDE_ENTERPRISE_ID=
# 团队空间 DriveId
CDE_DRIVE_ID=
# 合唱团父目录 file_id（盘内 choirs 文件夹；根目录建团填 root）
CDE_ROOT_FOLDER_ID=root
# 可选；仅主机名，不要 https://。默认 {CDE_DOMAIN_ID}.api.aliyunpds.com
CDE_ENDPOINT=
CDE_REGION=cn-hangzhou

# App
# 每团成员上限（新建 choir 时默认写入 choirs.max_members）
MAX_MEMBERS_PER_CHOIR=100
# 系统超管（choir_id 为空；用于 POST /api/choirs 创建合唱团）
SYSTEM_SUPER_ADMIN_USERNAME=13800000000
SYSTEM_SUPER_ADMIN_PASSWORD=change-me
INVITE_CODE_PEPPER=change-invite-pepper-in-production
REGISTRATION_MODE=invite_only
INVITE_CODE_DEFAULT_EXPIRE_DAYS=7
INVITE_CODE_LENGTH=8
